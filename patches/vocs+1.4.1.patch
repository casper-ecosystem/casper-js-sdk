<span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(deploy?.hash.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span></code></pre>\\n\",\"id\":\"pages/actions/transactions/getTransactionByDeployHash.mdx#usage\",\"isPage\":false,\"text\":\"\\nconst result = await rpcClient.getTransactionByDeployHash(&#x27;abc123...&#x27;);\\n \\nconst tx = result.transaction;\\n// The transaction wraps the deploy in Transaction format\\nconst deploy = tx.getDeploy();\\nconsole.log(deploy?.hash.toHex());\\n\",\"title\":\"Usage\",\"titles\":[\"getTransactionByDeployHash\"]},{\"href\":\"/actions/transactions/getTransactionByDeployHash#parameters\",\"html\":\"\\n\",\"id\":\"pages/actions/transactions/getTransactionByDeployHash.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"getTransactionByDeployHash\"]},{\"href\":\"/actions/transactions/getTransactionByDeployHash#hash\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code></li>\\n</ul>\\n<p>The deploy hash as a hex string.</p>\\n\",\"id\":\"pages/actions/transactions/getTransactionByDeployHash.mdx#hash\",\"isPage\":false,\"text\":\"\\n\\nType: string\\n\\nThe deploy hash as a hex string.\\n\",\"title\":\"hash\",\"titles\":[\"getTransactionByDeployHash\",\"Parameters\"]},{\"href\":\"/actions/transactions/getTransactionByDeployHash#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n\",\"id\":\"pages/actions/transactions/getTransactionByDeployHash.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\n\",\"title\":\"Return Value\",\"titles\":[\"getTransactionByDeployHash\"]},{\"href\":\"/actions/transactions/getTransactionByDeployHash#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/getDeploy\\\"><code>getDeploy</code></a></li>\\n<li><a href=\\\"/actions/transactions/getTransactionByTransactionHash\\\"><code>getTransactionByTransactionHash</code></a></li>