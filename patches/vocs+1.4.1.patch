\"color:#D73A49;--shiki-dark:#F47067\\\">of</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> eraEnd.rewards) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">`${</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">validator</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">}: ${</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">amounts</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">map</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">(</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">a</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =&gt;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> a</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toString</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">()).</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">join</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;, &#x27;</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">)</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">}`</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  }</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/types/era-end.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst client = new RpcClient(new HttpHandler(&#x27;http://node:7777/rpc&#x27;));\\nconst { block } = await client.getLatestBlock();\\n \\nif (block.eraEnd) {\\n  const eraEnd = block.eraEnd;\\n  console.log(&#x27;Era ended!&#x27;);\\n  console.log(&#x27;Equivocators:&#x27;, eraEnd.equivocators.length);\\n  console.log(&#x27;Inactive validators:&#x27;, eraEnd.inactiveValidators.length);\\n  console.log(&#x27;Next era validators:&#x27;, eraEnd.nextEraValidatorWeights.length);\\n  console.log(&#x27;Next era gas price:&#x27;, eraEnd.nextEraGasPrice);\\n \\n  for (const [validator, amounts] of eraEnd.rewards) {\\n    console.log(`${validator}: ${amounts.map(a =&gt; a.toString()).join(&#x27;, &#x27;)}`);\\n  }\\n}\\n\",\"title\":\"Usage\",\"titles\":[\"EraEnd\"]},{\"href\":\"/types/era-end#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/types/block\\\"><code>Block</code></a> - Block containing optional <code>EraEnd</code></li>\\n<li><a href=\\\"/types/era-info\\\"><code>EraInfo</code></a> - Era seigniorage allocation info</li>\\n<li><a href=\\\"/types/era-summary\\\"><code>EraSummary</code></a> - Era summary from RPC</li>\\n</ul>\",\"id\":\"pages/types/era-end.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nBlock - Block containing optional EraEnd\\nEraInfo - Era seigniorage allocation info\\nEraSummary - Era summary from RPC\\n\",\"title\":\"See Also\",\"titles\":[\"EraEnd\"]}]}}"
