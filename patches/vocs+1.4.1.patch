+"{\"value\":{\"mdx\":\"# getChainspec\\n\\nReturns the chain specification of the connected network.\\n\\n## Import\\n\\n```ts\\nimport { RpcClient, HttpHandler } from 'casper-js-sdk';\\n```\\n\\n## Usage\\n\\n```ts\\nconst result = await rpcClient.getChainspec();\\n\\nconsole.log(result.chainspecBytes); // raw chainspec bytes\\n```\\n\\n## Return Value\\n\\n`Promise<InfoGetChainspecResult>`\\n\\n```ts\\ninterface InfoGetChainspecResult {\\n  chainspecBytes: Uint8Array;\\n}\\n```\\n\\n## Related\\n\\n- [`getStatus`](/actions/node/getStatus)\\n\",\"document\":[{\"href\":\"/actions/node/getChainspec#getchainspec\",\"html\":\"</header>\\n<p>Returns the chain specification of the connected network.</p>\\n\",\"id\":\"pages/actions/node/getChainspec.mdx#getchainspec\",\"isPage\":true,\"text\":\"\\nReturns the chain specification of the connected network.\\n\",\"title\":\"getChainspec\",\"titles\":[]},{\"href\":\"/actions/node/getChainspec#import\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span></code></pre>\\n\",\"id\":\"pages/actions/node/getChainspec.mdx#import\",\"isPage\":false,\"text\":\"\\n \\n\",\"title\":\"Import\",\"titles\":[\"getChainspec\"]},{\"href\":\"/actions/node/getChainspec#usage\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> result</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> await</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> rpcClient.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">getChainspec</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(result.chainspecBytes); </span><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// raw chainspec bytes</span></span></code></pre>\\n\",\"id\":\"pages/actions/node/getChainspec.mdx#usage\",\"isPage\":false,\"text\":\"\\nconst result = await rpcClient.getChainspec();\\n \\nconsole.log(result.chainspecBytes); // raw chainspec bytes\\n\",\"title\":\"Usage\",\"titles\":[\"getChainspec\"]},{\"href\":\"/actions/node/getChainspec#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">interface</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> InfoGetChainspecResult</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#E36209;--shiki-dark:#F69D50\\\">  chainspecBytes</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">:</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> Uint8Array</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/node/getChainspec.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\ninterface InfoGetChainspecResult {\\n  chainspecBytes: Uint8Array;\\n}\\n\",\"title\":\"Return Value\",\"titles\":[\"getChainspec\"]},{\"href\":\"/actions/node/getChainspec#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/node/getStatus\\\"><code>getStatus</code></a></li>\\n</ul>\",\"id\":\"pages/actions/node/getChainspec.mdx#related\",\"isPage\":false,\"text\":\"\\n\\ngetStatus\\n\",\"title\":\"Related\",\"titles\":[\"getChainspec\"]}]}}"
