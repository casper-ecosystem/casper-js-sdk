768390\\\">// &#x27;01abff&#x27;</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> parsed</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> HexBytes.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">fromHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;01abff&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// HexBytes { bytes: Uint8Array [1, 171, 255] }</span></span></code></pre>\\n\",\"id\":\"pages/types/hex-bytes.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst hb = new HexBytes(new Uint8Array([0x01, 0xab, 0xff]));\\nhb.toHex();     // &#x27;01abff&#x27;\\nhb.toString();  // &#x27;01abff&#x27;\\n \\nconst parsed = HexBytes.fromHex(&#x27;01abff&#x27;);\\n// HexBytes { bytes: Uint8Array [1, 171, 255] }\\n\",\"title\":\"Usage\",\"titles\":[\"HexBytes\"]},{\"href\":\"/types/hex-bytes#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/types/byte-converters\\\"><code>ByteConverters</code></a> - Low-level byte serialization</li>\\n<li><a href=\\\"/types/conversions\\\"><code>Conversions</code></a> - Base16/Base64 encoding utilities</li>\\n</ul>\",\"id\":\"pages/types/hex-bytes.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nByteConverters - Low-level byte serialization\\nConversions - Base16/Base64 encoding utilities\\n\",\"title\":\"See Also\",\"titles\":[\"HexBytes\"]}]}}"
