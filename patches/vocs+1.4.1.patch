casper&#x27;)\\n  .payment(100_000_000)\\n  .build();\\n \\n// 4. Sign and submit\\ntransaction.sign(privateKey);\\nconst result = await rpcClient.putTransaction(transaction);\\nconsole.log(&#x27;Transaction hash:&#x27;, result.transactionHash);\\n \\n// 5. Wait for confirmation\\nconst confirmed = await rpcClient.waitForTransaction(result.transactionHash, {\\n  timeout: 300_000,\\n});\\nconsole.log(&#x27;Success:&#x27;, confirmed.executionInfo?.executionResult.isSuccess());\\n\",\"title\":\"Quick Start\",\"titles\":[\"Getting Started\"]},{\"href\":\"/docs/getting-started#node-urls\",\"html\":\"\\n<table><thead><tr><th>Network</th><th>RPC URL</th></tr></thead><tbody><tr><td>Mainnet</td><td><code>http://65.21.235.219:7777/rpc</code></td></tr><tr><td>Testnet</td><td><code>http://195.201.174.222:7777/rpc</code></td></tr></tbody></table>\\n<p>The RPC port is <code>7777</code>. The SSE (event stream) port is <code>9999</code>.</p>\\n\",\"id\":\"pages/docs/getting-started.mdx#node-urls\",\"isPage\":false,\"text\":\"\\nNetworkRPC URLMainnethttp://65.21.235.219:7777/rpcTestnethttp://195.201.174.222:7777/rpc\\nThe RPC port is 7777. The SSE (event stream) port is 9999.\\n\",\"title\":\"Node URLs\",\"titles\":[\"Getting Started\"]},{\"href\":\"/docs/getting-started#caspernetwork-version-aware\",\"html\":\"\\n<p>If you&#x27;re connecting to a mixed-version network or want automatic format selection, use <code>CasperNetwork</code>:</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> network</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span