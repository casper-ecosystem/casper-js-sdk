iki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Signed by:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, proof.publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/types/block.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst client = new RpcClient(new HttpHandler(&#x27;http://node:7777/rpc&#x27;));\\n \\nconst { block } = await client.getLatestBlock();\\n \\nconsole.log(&#x27;Height:&#x27;, block.height);\\nconsole.log(&#x27;Hash:&#x27;, block.hash.toHex());\\nconsole.log(&#x27;Era:&#x27;, block.eraID);\\nconsole.log(&#x27;Proposer:&#x27;, block.proposer.toJSON());\\nconsole.log(&#x27;Transactions:&#x27;, block.transactions.length);\\n \\nif (block.eraEnd) {\\n  console.log(&#x27;Switch block! Next era validators:&#x27;, block.eraEnd.nextEraValidatorWeights.length);\\n}\\n \\nfor (const proof of block.proofs) {\\n  console.log(&#x27;Signed by:&#x27;, proof.publicKey.toHex());\\n}\\n\",\"title\":\"Usage\",\"titles\":[\"Block\"]},{\"href\":\"/types/block#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/block/getLatestBlock\\\"><code>getLatestBlock</code></a> - Get the most recent block</li>\\n<li><a href=\\\"/actions/block/getBlockByHash\\\"><code>getBlockByHash</code></a> - Get a block by hash</li>\\n<li><a href=\\\"/types/block-proposer\\\"><code>BlockProposer</code></a> - Proposer type</li>\\n<li><a href=\\\"/types/era-end\\\"><code>EraEnd</code></a> - Era-end data on switch blocks</li>\\n</ul>\",\"id\":\"pages/types/block.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\ngetLatestBlock - Get the most recent block\\ngetBlockByHash - Get a block by hash\\nBlockProposer - Proposer type\\nEraEnd - Era-end data on switch blocks\\n\",\"title\":\"See Also\",\"titles\":[\"Block\"]}]}}"
