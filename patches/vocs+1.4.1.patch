/span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, fault.publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Era ID:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, fault.eraId);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Timestamp:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, fault.timestamp);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span></code></pre>\\n\",\"id\":\"pages/sse/fault.mdx#usage\",\"isPage\":false,\"text\":\"\\nsseClient.subscribe(EventName.FaultEventType, (raw) =&gt; {\\n  const result = raw.parseAsFaultEvent();\\n  if (result.err) return;\\n \\n  const fault = result.val.fault;\\n  console.log(&#x27;Equivocating validator:&#x27;, fault.publicKey.toHex());\\n  console.log(&#x27;Era ID:&#x27;, fault.eraId);\\n  console.log(&#x27;Timestamp:&#x27;, fault.timestamp);\\n});\\n\",\"title\":\"Usage\",\"titles\":[\"Fault\"]},{\"href\":\"/sse/fault#payload\",\"html\":\"\\n\",\"id\":\"pages/sse/fault.mdx#payload\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Payload\",\"titles\":[\"Fault\"]},{\"href\":\"/sse/fault#faultpayload\",\"html\":\"\\n<table><thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead><tbody><tr><td><code>eraId</code></td><td><code>number</code></td><td>Era in which the fault occurred</td></tr><tr><td><code>timestamp</code></td><td><code>string</code></td><td>Time of detection</td></tr><tr><td><code>publicKey</code></td><td><code>PublicKey</code></td><td>The equivocating validator&#x27;s key</td></tr></tbody></table>\\n\",\"id\":\"pages/sse/fault.mdx#faultpayload\",\"isPage\":false,\"text\":\"\\nFieldTypeDescriptioneraIdnumberEra in which the fault occurredtimestampstringTime of detectionpublicKeyPublicKeyThe equivocating validator&#x27;s key\\n\",\"title\":\"FaultPayload\",\"titles\":[\"Fault\",\"Payload\"]},{\"href\":\"/sse/fault#notes\",\"html\":\"\\n<ul>\\n<li>Equivocating validators are slashed (lose part of their stake).</li>\\n<li>This event is rare in practice on well-operated networks.</li>\\n</ul>\",\"id\":\"pages/sse/fault.mdx#notes\",\"isPage\":false,\"text\":\"\\n\\nEquivocating validators are slashed (lose part of their stake).\\nThis event is rare in practice on well-operated networks.\\n\",\"title\":\"Notes\",\"titles\":[\"Fault\"]}]}}"
