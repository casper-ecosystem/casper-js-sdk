executionInfo?.executionResult;\\n \\nif (execResult?.isSuccess()) {\\n  console.log(&#x27;Transaction succeeded&#x27;);\\n} else {\\n  console.log(&#x27;Failed:&#x27;, execResult?.getErrorMessage());\\n}\\n\",\"title\":\"Usage\",\"titles\":[\"getTransactionByTransactionHash\"]},{\"href\":\"/actions/transactions/getTransactionByTransactionHash#parameters\",\"html\":\"\\n\",\"id\":\"pages/actions/transactions/getTransactionByTransactionHash.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"getTransactionByTransactionHash\"]},{\"href\":\"/actions/transactions/getTransactionByTransactionHash#hash\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code></li>\\n</ul>\\n<p>The TransactionV1 hash as a hex string.</p>\\n\",\"id\":\"pages/actions/transactions/getTransactionByTransactionHash.mdx#hash\",\"isPage\":false,\"text\":\"\\n\\nType: string\\n\\nThe TransactionV1 hash as a hex string.\\n\",\"title\":\"hash\",\"titles\":[\"getTransactionByTransactionHash\",\"Parameters\"]},{\"href\":\"/actions/transactions/getTransactionByTransactionHash#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">interface</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> InfoGetTransactionResult</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#E36209;--shiki-dark:#F69D50\\\">  transaction</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">:</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> Transaction</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">  // executionInfo is present only after the transaction is finalized</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n<aside data-callout=\\\"note\\\"><p>The <code>executionInfo</code> field is <code>undefined</code> if the transaction is still pending. Use <a href=\\\"/actions/transactions/waitForTransaction\\\"><code>waitForTransaction</code></a> to poll until finalization.</p></aside>\\n\",\"id\":\"pages/actions/transactions/getTransactionByTransactionHash.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\ninterface InfoGetTransactionResult {\\n  transaction: Transaction;\\n  // executionInfo is present only after the transaction is finalized\\n}\\nThe executionInfo field is undefined if the transaction is still pending. Use waitForTransaction to poll until finalization.\\n\",\"title\":\"Return Value\",\"titles\":[\"getTransactionByTransactionHash\"]},{\"href\":\"/actions/transactions/getTransactionByTransactionHash#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/getTransactionByDeployHash\\\"><code>getTransactionByDeployHash</code></a></li>\\n<li><a href=\\\"/actions/transactions/getDeploy\\\"><code>getDeploy</code></a></li>\\n<li><a href=\\\"/actions/transactions/waitForTransaction\\\"><code>waitForTransaction</code></a></li>\\n</ul>\",\"id\":\"pages/actions/transactions/getTransactionByTransactionHash.mdx#related\",\"isPage\":false,\"text\":\"\\n\\ngetTransactionByDeployHash\\ngetDeploy\\nwaitForTransaction\\n\",\"title\":\"Related\",\"titles\":[\"getTransactionByTransactionHash\"]}]}}"
