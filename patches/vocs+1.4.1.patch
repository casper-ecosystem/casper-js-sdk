\":\"/actions/balance/queryBalanceByBlockHash#parameters\",\"html\":\"\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHash.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"queryBalanceByBlockHash\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHash#hash\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code></li>\\n</ul>\\n<p>Block hash as hex string.</p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHash.mdx#hash\",\"isPage\":false,\"text\":\"\\n\\nType: string\\n\\nBlock hash as hex string.\\n\",\"title\":\"hash\",\"titles\":[\"queryBalanceByBlockHash\",\"Parameters\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHash#identifier\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PurseIdentifier</code></li>\\n</ul>\\n<p>Which purse to query. Same options as <a href=\\\"/actions/balance/queryLatestBalance\\\"><code>queryLatestBalance</code></a>.</p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHash.mdx#identifier\",\"isPage\":false,\"text\":\"\\n\\nType: PurseIdentifier\\n\\nWhich purse to query. Same options as queryLatestBalance.\\n\",\"title\":\"identifier\",\"titles\":[\"queryBalanceByBlockHash\",\"Parameters\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHash#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHash.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\n\",\"title\":\"Return Value\",\"titles\":[\"queryBalanceByBlockHash\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHash#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/balance/queryLatestBalance\\\"><code>queryLatestBalance</code></a></li>\\n<li><a href=\\\"/actions/balance/queryBalanceByBlockHeight\\\"><code>queryBalanceByBlockHeight</code></a></li>\\n</ul>\",\"id\":\"pages/actions/balance/queryBalanceByBlockHash.mdx#related\",\"isPage\":false,\"text\":\"\\n\\nqueryLatestBalance\\nqueryBalanceByBlockHeight\\n\",\"title\"