-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/auction/getValidatorChangesInfo.mdx#usage\",\"isPage\":false,\"text\":\"\\nconst result = await rpcClient.getValidatorChangesInfo();\\n \\nfor (const change of result.changes) {\\n  console.log(&#x27;Validator:&#x27;, change.publicKey.toHex());\\n  console.log(&#x27;Status changes:&#x27;, change.statusChanges);\\n}\\n\",\"title\":\"Usage\",\"titles\":[\"getValidatorChangesInfo\"]},{\"href\":\"/actions/auction/getValidatorChangesInfo#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">interface</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> InfoGetValidatorChangesResult</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#E36209;--shiki-dark:#F69D50\\\">  changes</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">:</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> ValidatorChange</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">[];</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/auction/getValidatorChangesInfo.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\ninterface InfoGetValidatorChangesResult {\\n  changes: ValidatorChange[];\\n}\\n\",\"title\":\"Return Value\",\"titles\":[\"getValidatorChangesInfo\"]},{\"href\":\"/actions/auction/getValidatorChangesInfo#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/auction/getLatestAuctionInfo\\\"><code>getLatestAuctionInfo</code></a></li>\\n</ul>\",\"id\":\"pages/actions/auction/getValidatorChangesInfo.mdx#related\",\"isPage\":false,\"t