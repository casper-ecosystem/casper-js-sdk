olor:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Block hash:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, v1.blockHash);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Validator:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, v1.publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  }</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span></code></pre>\\n\",\"id\":\"pages/sse/finality-signature.mdx#usage\",\"isPage\":false,\"text\":\"\\nsseClient.subscribe(EventName.FinalitySignatureEventType, (raw) =&gt; {\\n  const result = raw.parseAsFinalitySignatureEvent();\\n  if (result.err) return;\\n \\n  const sig = result.val.finalitySignature;\\n \\n  // Casper 2.x\\n  const v2 = sig.getFinalitySignatureV2();\\n  if (v2) {\\n    console.log(&#x27;Block hash:&#x27;, v2.blockHash);\\n    console.log(&#x27;Validator:&#x27;, v2.publicKey.toHex());\\n    console.log(&#x27;Chain name hash:&#x27;, v2.chainNameHash);\\n    console.log(&#x27;Signature:&#x27;, v2.signature);\\n  }\\n \\n  // Casper 1.x\\n  const v1 = sig.getFinalitySignatureV1();\\n  if (v1) {\\n    console.log(&#x27;Block hash:&#x27;, v1.blockHash);\\n    console.log(&#x27;Validator:&#x27;, v1.publicKey.toHex());\\n  }\\n});\\n\",\"title\":\"Usage\",\"titles\":[\"FinalitySignature\"]},{\"href\":\"/sse/finality-signature#payload\",\"html\":\"\\n<p>The <code>FinalitySignature</code> wrapper holds either a V1 or V2 signature.</p>\\n<table><thead><tr><th>Method</th><th>Returns</th></tr></thead><tbody><tr><td><code>getFinalitySignatureV2()</code></td><td><code>FinalitySignatureV2 | undefined</code></td></tr><tr><td><code>getFinalitySignatureV1()</code></td><td><code>FinalitySignatureV1 | undefined</code></td></tr></tbody></table>\\n\",\"id\":\"pages/sse/finality-signature.mdx#payload\",\"isPage\":false,\"text\":\"\\nThe FinalitySignature wrapper holds either a V1 or V2 signature.\\nMethodReturnsgetFinalitySignatureV2()FinalitySignatureV2 | undefinedgetFinalitySignatureV1()FinalitySignatureV1 | undefined\\n\",\"title\":\"Payload\",\"titles\":[\"FinalitySignature\"]},{\"href\":\"/sse/finality-signature#finalitysignaturev2-fields\",\"html\":\"\\n<table><thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead><tbody><tr><td><code>blockHash</code></td><td><code>string</code></td><td>Signed block hash</td></tr><tr><td><code>blockHeight</code></td><td><code>number</code></td><td>Block height</td></tr><tr><td><code>chainNameHash</code></td><td><code>string</code></td><td>Hash of the chain name</td></tr><tr><td><code>era</code></td><td><code>number</code></td><td>Era ID</td></tr><tr><td><code>publicKey</code></td><td><code>PublicKey</code></td><td>Signing validator&#x27;s key</td></tr><tr><td><code>signature</code></td><td><code>string</code></td><td>Hex-encoded signature</td></tr></tbody></table>\",\"id\":\"pages/sse/finality-signature.mdx#finalitysignaturev2-fields\",\"isPage\":false,\"text\":\"\\nFieldTypeDescriptionblockHashstringSigned block hashblockHeightnumberBlock heightchainNameHashstringHash of the chain nameeranumberEra IDpublicKeyPublicKeySigning validator&#x27;s keysignaturestringHex-encoded signature\",\"title\":\"FinalitySignatureV2 Fields\",\"titles\":[\"FinalitySignature\",\"Payload\"]}]}}"
