+"{\"value\":{\"mdx\":\"# BidKind\\n\\nA polymorphic container for all bid variants in the Casper 2.x auction system.\\n\\n## Import\\n\\n```ts\\nimport { BidKind } from 'casper-js-sdk';\\n```\\n\\n## Class\\n\\n### `BidKind`\\n\\nA discriminated union that holds one of several bid types. Only one field is set at a time.\\n\\n| Property | Type | Description |\\n|---|---|---|\\n| `unified?` | `Bid` | Legacy unified bid (Casper 1.x) |\\n| `validator?` | `ValidatorBid` | Validator bid |\\n| `delegator?` | `Delegator` | Delegator bid |\\n| `bridge?` | `Bridge` | Bridge bid used during validator key changes |\\n| `credit?` | `Credit` | Credit bid |\\n| `reservation?` | `Reservation` | Reserved delegation slot bid |\\n| `unbond?` | `Unbond` | Pending unbonding request |\\n\\n## Usage\\n\\n```ts\\nimport { RpcClient, HttpHandler } from 'casper-js-sdk';\\n\\nconst client = new RpcClient(new HttpHandler('http://node:7777/rpc'));\\nconst { auctionState } = await client.getLatestAuctionInfo();\\n\\nfor (const wrapper of auctionState.bids) {\\n  const { bid } = wrapper;\\n\\n  if (bid.validator) {\\n    console.log('Validator bid, staked:', bid.validator.stakedAmount.toString());\\n  } else if (bid.delegator) {\\n    console.log('Delegator bid, to:', bid.delegator.validatorPublicKey.toHex());\\n  } else if (bid.credit) {\\n    console.log('Credit bid');\\n  } else if (bid.bridge) {\\n    console.log('Bridge bid');\\n  }\\n}\\n```\\n\\n## See Also\\n\\n- [`Bid`](/types/bid) - Individual bid type definitions\\n- [`AuctionState`](/types/auction-state) - Contains `BidKindWrapper[]`\\n\",\"document\":[{\"href\":\"/types/bid-kind#bidkind\",\"html\":\"</header>\\n<p>A polymorphic container for all bid variants in the Casper 2.x auction system.</p>\\n\",\"id\":\"pages/types/bid-kind.mdx#bidkind\",\"isPage\":true,\"text\":\"\\nA polymorphic container for all bid variants in the Casper 2.x auction system.\\n\",\"title\":\"BidKind\",\"titles\":[]},{\"href\":\"/types/bid-kind#import\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span></code></pre>\\n\",\"id\":\"pages/types/bid-kind.mdx#import\",\"isPage\":false,\"text\":\"\\n \\n\",\"title\":\"Import\",\"titles\":[\"BidKind\"]},{\"href\":\"/types/bid-kind#class\",\"html\":\"\\n\",\"id\":\"pages/types/bid-kind.mdx#class\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Class\",\"titles\":[\"BidKind\"]},{\"href\":\"/types/bid-kind#bidkind-1\",\"html\":\"\\n<p>A discriminated union that holds one of several bid types. Only one field is set at a time.</p>\\n<table><thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead><tbody><tr><td><code>unified?</code></td><td><code>Bid</code></td><td>Legacy unified bid (Casper 1.x)</td></tr><tr><td><code>validator?</code></td><td><code>ValidatorBid</code></td><td>Validator bid</td></tr><tr><td><code>delegator?</code></td><td><code>Delegator</code></td><td>Delegator bid</td></tr><tr><td><code>bridge?</code></td><td><code>Bridge</code></td><td>Bridge bid used during validator key changes</td></tr><tr><td><code>credit?</code></td><td><code>Credit</code></td><td>Credit bid</td></tr><tr><td><code>reservation?</code></td><td><code>Reservation</code></td><td>Reserved delegation slot bid</td></tr><tr><td><code>unbond?</code></td><td><code>Unbond</code></td><td>Pending unbonding request</td></tr></tbody></table>\\n\",\"id\":\"pages/types/bid-kind.mdx#bidkind-1\",\"isPage\":false,\"text\":\"\\nA discriminated union that holds one of several bid types. Only one field is set at a time.\\nPropertyTypeDescriptionunified?BidLegacy unified bid (Casper 1.x)validator?ValidatorBidValidator biddelegator?DelegatorDelegator bidbridge?BridgeBridge bid used during validator key changescredit?CreditCredit bidreservation?ReservationReserved delegation slot bidunbond?UnbondPending unbonding request\\n\",\"title\":\"BidKind\",\"titles\":[\"BidKind\",\"Class\"]},{\"href\":\"/types/bid-kind#usage\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> client</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> RpcClient</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> HttpHandler</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;http://node:7777/rpc&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">));</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> { </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">auctionState</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> } </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">=</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> await</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> client.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">getLatestAuctionInfo</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">for</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> wrapper</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> of</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> auctionState.bids) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">  const</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> { </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">bid</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> } </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">=</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> wrapper;</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">  if</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (bid.validator) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Validator bid, staked:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, bid.validator.stakedAmount.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toString</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  } </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">else</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> if</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (bid.delegator) {</span></span>\\n<span class=\\\"l