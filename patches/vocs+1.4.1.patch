rk:#96D0FF\\\">&#x27;casper&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  payment: </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">3_000_000_000</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">deploy.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">sign</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(privateKey);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> result</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> await</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> rpcClient.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">putDeploy</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(deploy);</span></span></code></pre>\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#usage\",\"isPage\":false,\"text\":\"\\nconst deploy = makeCep18TransferDeploy({\\n  contractPackageHash: &#x27;hash-cep18-contract-abc...&#x27;,\\n  from: senderPublicKey,\\n  recipient: recipientPublicKey,\\n  amount: &#x27;1000000000&#x27;,   // token amount (check contract decimals)\\n  chainName: &#x27;casper&#x27;,\\n  payment: 3_000_000_000,\\n});\\n \\ndeploy.sign(privateKey);\\nconst result = await rpcClient.putDeploy(deploy);\\n\",\"title\":\"Usage\",\"titles\":[\"makeCep18TransferDeploy\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#parameters\",\"html\":\"\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"makeCep18TransferDeploy\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#contractpackagehash\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code> - required</li>\\n</ul>\\n<p>The CEP-18 token contract&#x27;s package hash.</p>\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#contractpackagehash\",\"isPage\":false,\"text\":\"\\n\\nType: string - required\\n\\nThe CEP-18 token contract&#x27;s package hash.\\n\",\"title\":\"contractPackageHash\",\"titles\":[\"makeCep18TransferDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#from\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PublicKey</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#from\",\"isPage\":false,\"text\":\"\\n\\nType: PublicKey - required\\n\\n\",\"title\":\"from\",\"titles\":[\"makeCep18TransferDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#recipient\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PublicKey | AccountHash</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#recipient\",\"isPage\":false,\"text\":\"\\n\\nType: PublicKey | AccountHash - required\\n\\n\",\"title\":\"recipient\",\"titles\":[\"makeCep18TransferDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#amount\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code> - required</li>\\n</ul>\\n<p>Token amount. The decimal precision depends on the specific token contract.</p>\\n\",\"id\":\"pages/utilities/makeCep18TransferDeploy.mdx#amount\",\"isPage\":false,\"text\":\"\\n\\nType: string - required\\n\\nToken amount. The decimal precision depends on the specific token contract.\\n\",\"title\":\"amount\",\"titles\":[\"makeCep18TransferDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeCep18TransferDeploy#chainname\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <