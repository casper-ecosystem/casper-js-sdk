 string          // ISO 8601 string\\nTimestamp.fromJSON(data: string): Timestamp\\n\",\"title\":\"Methods\",\"titles\":[\"Time\",\"Classes\",\"Timestamp\"]},{\"href\":\"/types/time#duration\",\"html\":\"\\n<p>Represents a time duration in milliseconds. Serializes to/from human-readable strings like <code>&quot;30m&quot;</code> or <code>&quot;1day 30m&quot;</code>.</p>\\n<table><thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead><tbody><tr><td><code>duration</code></td><td><code>number</code></td><td>Duration in milliseconds</td></tr></tbody></table>\\n\",\"id\":\"pages/types/time.mdx#duration\",\"isPage\":false,\"text\":\"\\nRepresents a time duration in milliseconds. Serializes to/from human-readable strings like &quot;30m&quot; or &quot;1day 30m&quot;.\\nPropertyTypeDescriptiondurationnumberDuration in milliseconds\\n\",\"title\":\"Duration\",\"titles\":[\"Time\",\"Classes\"]},{\"href\":\"/types/time#constructor-1\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> Duration</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(duration: number)</span></span></code></pre>\\n\",\"id\":\"pages/types/time.mdx#constructor-1\",\"isPage\":false,\"text\":\"\\nnew Duration(duration: number)\\n\",\"title\":\"Constructor\",\"titles\":[\"Time\",\"Classes\",\"Duration\"]},{\"href\":\"/types/time#methods-1\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">duration.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\