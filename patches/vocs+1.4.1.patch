\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    pm.paymentLimited </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">=</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> Object.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">assign</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> PaymentLimitedMode</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(), {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">      paymentAmount: </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">100_000_000</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">      gasPriceTolerance: </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">1</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">      standardPayment: </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">true</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    });</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">    return</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> pm;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  })(),</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> tx</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> TransactionV1.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">newTransactionV1</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(payload);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">tx.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">sign</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(privateKey);</span></span></code></pre>\\n<aside data-callout=\\\"tip\\\"><p>Use transaction builders like <code>NativeTransferBuilder</code> instead of building payloads manually - they handle all of this automatically.</p></aside>\\n\",\"id\":\"pages/types/transaction-v1-payload.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n  TransactionV1Payload, TransactionV1,\\n  InitiatorAddr, Args, Duration, Timestamp,\\n  TransactionEntryPoint, TransactionEntryPointEnum,\\n  PricingMode, PaymentLimitedMode,\\n  TransactionTarget, TransactionScheduling,\\n  newCLU512, PrivateKey, KeyAlgorithm,\\n} from &#x27;casper-js-sdk&#x27;;\\n \\nconst privateKey = PrivateKey.generate(KeyAlgorithm.ED25519);\\n \\nconst payload = TransactionV1Payload.build({\\n  initiatorAddr: new InitiatorAddr(privateKey.publicKey),\\n  chainName: &#x27;casper&#x27;,\\n  timestamp: new Timestamp(new Date()),\\n  ttl: Duration.fromJSON(&#x27;30m&#x27;),\\n  args: Args.fromMap({ amount: newCLU512(&#x27;2500000000&#x27;) }),\\n  entryPoint: new TransactionEntryPoint(TransactionEntryPointEnum.Transfer),\\n  transactionTarget: new TransactionTarget({}),\\n  scheduling: new TransactionScheduling({}),\\n  pricingMode: (() =&gt; {\\n    const pm = new PricingMode();\\n    pm.paymentLimited = Object.assign(new PaymentLimitedMode(), {\\n      paymentAmount: 100_000_000,\\n      gasPriceTolerance: 1,\\n      standardPayment: true,\\n    });\\n    return pm;\\n  })(),\\n});\\n \\nconst tx = TransactionV1.newTransactionV1(payload);\\ntx.sign(privateKey);\\nUse transaction builders like NativeTransferBuilder instead of building payloads manually - they handle all of this automatically.\\n\",\"title\":\"Usage\",\"titles\":[\"TransactionV1Payload\"]},{\"href\":\"/types/transaction-v1-payload#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/builders/introduction\\\">Transaction Builders</a> - High-level API</li>\\n<li><a href=\\\"/types/transaction\\\"><code>Transaction</code></a> - Wrapper type</li>\\n<li><a href=\\\"/types/transaction-target\\\"><code>TransactionTarget</code></a> - Target field</li>\\n<li><a href=\\\"/types/transaction-entry-point\\\"><code>TransactionEntryPoint</code></a> - Entry point field</li>\\n<li><a href=\\\"/types/pricing-mode\\\"><code>PricingMode</code></a> - Pricing field</li>\\n</ul>\",\"id\":\"pages/types/transaction-v1-payload.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nTransaction Builders - High-level API\\nTransaction - Wrapper type\\nTransactionTarget - Target field\\nTransactionEntryPoint - Entry point field\\nPricingMode - Pricing field\\n\",\"title\":\"See Also\",\"titles\":[\"TransactionV1Payload\"]}]}}"
