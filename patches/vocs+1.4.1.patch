:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">accountHash</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">().</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toFormattedStr</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span></code></pre>\\n<hr/>\\n\",\"id\":\"pages/accounts/public-key.mdx#example-2\",\"isPage\":false,\"text\":\"\\nconst hash = publicKey.accountHash();\\nconsole.log(hash.toFormattedStr());\\n// → &#x27;account-hash-abc123...&#x27;\\n \\n// Used as deposit address for exchanges\\nconst depositAddress = publicKey.accountHash().toFormattedStr();\\n\\n\",\"title\":\"Example\",\"titles\":[\"PublicKey\",\"Methods\",\"accountHash\"]},{\"href\":\"/accounts/public-key#verifysignature\",\"html\":\"\\n<p>Verifies a signature against a message.</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">verifySignature</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(message: Uint8Array, sig: Uint8Array): boolean</span></span></code></pre>\\n\",\"id\":\"pages/accounts/public-key.mdx#verifysignature\",\"isPage\":false,\"text\":\"\\nVerifies a signature against a message.\\npublicKey.verifySignature(message: Uint8Array, sig: Uint8Array): boolean\\n\",\"title\":\"verifySignature\",\"titles\":[\"PublicKey\",\"Methods\"]},{\"href\":\"/accounts/public-key#parameters-1\",\"html\":\"\\n\",\"id\":\"pages/accounts/public-key.mdx#parameters-1\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"PublicKey\",\"Methods\",\"verifySignature\"]},{\"href\":\"/accounts/public-key#message\"