:\"/utilities/makeAuctionManagerDeploy#delegator\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PublicKey</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeAuctionManagerDeploy.mdx#delegator\",\"isPage\":false,\"text\":\"\\n\\nType: PublicKey - required\\n\\n\",\"title\":\"delegator\",\"titles\":[\"makeAuctionManagerDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeAuctionManagerDeploy#validator\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PublicKey</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeAuctionManagerDeploy.mdx#validator\",\"isPage\":false,\"text\":\"\\n\\nType: PublicKey - required\\n\\n\",\"title\":\"validator\",\"titles\":[\"makeAuctionManagerDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeAuctionManagerDeploy#newvalidator\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PublicKey</code> - required for <code>redelegate</code> only</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeAuctionManagerDeploy.mdx#newvalidator\",\"isPage\":false,\"text\":\"\\n\\nType: PublicKey - required for redelegate only\\n\\n\",\"title\":\"newValidator\",\"titles\":[\"makeAuctionManagerDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeAuctionManagerDeploy#amount\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeAuctionManagerDeploy.mdx#amount\",\"isPage\":false,\"text\":\"\\n\\nType: string - required\\n\\n\",\"title\":\"amount\",\"titles\":[\"makeAuctionManagerDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeAuctionManagerDeploy#chainname\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>string</code> - required</li>\\n</ul>\\n\",\"id\":\"pages/utilities/makeAuctionManagerDeploy.mdx#chainname\",\"isPage\":false,\"text\":\"\\n\\nType: string - required\\n\\n\",\"title\":\"chainName\",\"titles\":[\"makeAuctionManagerDeploy\",\"Parameters\"]},{\"href\":\"/utilities/makeAuctionManagerDeploy#payment\",\"html\":\"\\n<ul>\\n<li>