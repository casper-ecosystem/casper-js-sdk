i-dark:#ADBAC7\\\">} </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">catch</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (err) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">error</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Timed out waiting for transaction&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/transactions/waitForTransaction.mdx#example-with-error-handling\",\"isPage\":false,\"text\":\"\\ntry {\\n  const tx = await rpcClient.waitForTransaction(hash, {\\n    timeout: 300_000,  // 5 minutes\\n    interval: 3_000,   // check every 3 seconds\\n  });\\n \\n  const result = tx.executionInfo?.executionResult;\\n  if (result?.isSuccess()) {\\n    const transfers = result.getSuccessTransfers();\\n    console.log(&#x27;Transfers:&#x27;, transfers?.length);\\n  }\\n} catch (err) {\\n  console.error(&#x27;Timed out waiting for transaction&#x27;);\\n}\\n\",\"title\":\"Example with Error Handling\",\"titles\":[\"waitForTransaction\"]},{\"href\":\"/actions/transactions/waitForTransaction#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/putTransaction\\\"><code>putTransaction</code></a></li>\\n<li><a href=\\\"/sse/transaction-processed\\\">SSE: TransactionProcessed</a> - event-based alternative</li>\\n</ul>\",\"id\":\"pages/actions/transactions/waitForTransaction.mdx#related\",\"isPage\":false,\"text\":\"\\n\\nputTransaction\\nSSE: TransactionProcessed - event-based alternative\\n\",\"title\":\"Related\",\"titles\":[\"waitForTransaction\"]}]}}"
