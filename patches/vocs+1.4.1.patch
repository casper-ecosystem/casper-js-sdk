ec85d7acbab1497b65de48a1a707b64&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span></code></pre>\\n<hr/>\\n\",\"id\":\"pages/accounts/public-key.mdx#example\",\"isPage\":false,\"text\":\"\\n// ED25519 public key (starts with &#x27;01&#x27;)\\nconst ed25519Key = PublicKey.fromHex(&#x27;01a8b1d7f4e9c2...&#x27;);\\n \\n// SECP256K1 public key (starts with &#x27;02&#x27;, 33 bytes compressed)\\nconst secp256k1Key = PublicKey.fromHex(&#x27;0202f5a92ab6da536e7b1a351406f3744224bec85d7acbab1497b65de48a1a707b64&#x27;);\\n\\n\",\"title\":\"Example\",\"titles\":[\"PublicKey\",\"Methods\",\"PublicKey.fromHex\"]},{\"href\":\"/accounts/public-key#publickeyfrompem\",\"html\":\"\\n<p>Imports a public key from PEM format.</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">PublicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">fromPem</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(content: string, algorithm: KeyAlgorithm): PublicKey</span></span></code></pre>\\n<hr/>\\n\",\"id\":\"pages/accounts/public-key.mdx#publickeyfrompem\",\"isPage\":false,\"text\":\"\\nImports a public key from PEM format.\\nPublicKey.fromPem(content: string, algorithm: KeyAlgorithm): PublicKey\\n\\n\",\"title\":\"PublicKey.fromPem\",\"titles\":[\"PublicKey\",\"Methods\"]},{\"href\":\"/accounts/public-key#publickeyfrombytes\",\"html\":\"\\n<p>Creates a public key from raw bytes. Returns a result wrapper, not a direct <code>PublicKey</code>.</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">PublicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">fromBytes</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(source: Uint8Array): IResultWithBytes</span></span></code></pre>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> result</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> PublicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">fromBytes</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(bytes);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">if</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (result.result.err) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">error</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(result.result.val);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">} </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">else</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">  const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> publicKey</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> result.result.val;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n<hr/>\\n\",\"id\":\"pages/accounts/public-key.mdx#publickeyfrombytes\",\"isPage\":false,\"text\":\"\\nCreates a public key from raw bytes. Returns a result wrapper, not a direct PublicKey.\\nPublicKey.fromBytes(source: Uint8Array): IResultWithBytes\\n \\n \\nconst result = PublicKey.fromBytes(bytes);\\nif (result.result.err) {\\n  console.error(result.result.val);\\n} else {\\n  const publicKey = result.result.val;\\n}\\n\\n\",\"title\":\"PublicKey.fromBytes\",\"titles\":[\"PublicKey\",\"Methods\"]},{\"href\":\"/accounts/public-key#tohex\",\"html\":\"\\n<p>Returns the prefixed hex string representation.</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(checksummed</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">?:</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> boolean): string</span></span></code></pre>\\n\",\"id\":\"pages/accounts/public-key.mdx#tohex\",\"isPage\":false,\"text\":\"\\nReturns the prefixed hex string representation.\\npublicKey.toHex(checksummed?: boolean): string\\n\",\"title\":\"toHex\",\"titles\":[\"PublicKey\",\"Methods\"]},{\"href\":\"/accounts/public-key#return-value-1\",\"html\":\"\\n<p><code>string</code> - <code>&#x27;01&#x27; + 32-byte-hex</code> for ED25519 or <code>&#x27;02&#x27; + 33-byte-hex</code> for SECP256K1.</p>\\n\",\"id\":\"pages/accounts/public-key.mdx#return-value-1\",\"isPage\":false,\"text\":\"\\nstring - &#x27;01&#x27; + 32-byte-hex for ED25519 or &#x27;02&#x27; + 33-byte-hex for SECP256K1.\\n\",\"title\":\"Return Value\",\"titles\":[\"PublicKey\",\"Methods\",\"toHex\"]},{\"href\":\"/accounts/public-key#example-1\",\"html\":\"\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// → &#x27;01a8b1d7f4e9c2...&#x27; (66 chars for ED25519)</span></span></code></pre>\\n<hr/>\\n\",\"id\":\"pages/accounts/public-key.mdx#example-1\",\"isPage\":false,\"text\":\"\\nconsole.log(publicKey.toHex());\\n// → &#x27;01a8b1d7f4e9c2...&#x27; (66 chars for ED25519)\\n\\n\",\"title\":\"Example\",\"titles\":[\"PublicKey\",\"Methods\",\"toHex\"]},{\"href\":\"/accounts/public-key#accounthash\",\"html\":\"\\n<p>Derives the on-chain account hash from this public key.</p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">publicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">accountHash</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(): AccountHash</span></span></code></pre>\\n<p>The account hash is computed as <code>blake2b-256(algorithmName + &#x27;\\\\0&#x27; + publicKeyBytes)</code>.</p>\\n\",\"id\":\"pages/accounts/public-key.mdx#accounthash\",\"isPage\":false,\"text\":\"\\nDerives the on-chain account hash from this public key.\\npublicKey.accountHash(): AccountHash\\nThe account hash is computed as blake2b-256(algorithmName