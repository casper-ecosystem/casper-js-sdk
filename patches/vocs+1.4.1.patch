r:#24292E;--shiki-dark:#ADBAC7\\\">deploy.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">sign</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(privateKey);</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> result</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> await</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> rpcClient.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">putDeploy</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(deploy);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Deploy hash:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, result.deployHash);</span></span></code></pre>\\n\",\"id\":\"pages/actions/transactions/putDeploy.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst deploy = makeCsprTransferDeploy({\\n  from: publicKey,\\n  to: targetPublicKey,\\n  amount: &#x27;2500000000&#x27;,\\n  id: Date.now(),\\n  chainName: &#x27;casper&#x27;,\\n});\\n \\ndeploy.sign(privateKey);\\n \\nconst result = await rpcClient.putDeploy(deploy);\\nconsole.log(&#x27;Deploy hash:&#x27;, result.deployHash);\\n\",\"title\":\"Usage\",\"titles\":[\"putDeploy\"]},{\"href\":\"/actions/transactions/putDeploy#parameters\",\"html\":\"\\n\",\"id\":\"pages/actions/transactions/putDeploy.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"putDeploy\"]},{\"href\":\"/actions/transactions/putDeploy#deploy\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>Deploy</code></li>\\n</ul>\\n<p>A signed <code>Deploy</code> object. The legacy transaction format for Casper 1.x.</p>\\n\",\"id\":\"pages/actions/transactions/putDeploy.mdx#deploy\",\"isPage\":false,\"text\":\"\\n\\nType: Deploy\\n\\nA signed Deploy object. The legacy transaction format for Casper 1.x.\\n\",\"title\":\"deploy\",\"titles\":[\"putDeploy\",\"Parameters\"]},{\"href\":\"/actions/transactions/putDeploy#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">interface</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> PutDeployResult</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#E36209;--shiki-dark:#F69D50\\\">  deployHash</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">:</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> string</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/transactions/putDeploy.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\ninterface PutDeployResult {\\n  deployHash: string;\\n}\\n\",\"title\":\"Return Value\",\"titles\":[\"putDeploy\"]},{\"href\":\"/actions/transactions/putDeploy#notes\",\"html\":\"\\n<ul>\\n<li>For new code, prefer <a href=\\\"/actions/transactions/putTransaction\\\"><code>putTransaction</code></a> with <code>NativeTransferBuilder</code> or other builders.</li>\\n<li><code>Deploy</code> is still supported by all Casper nodes including 2.x.</li>\\n</ul>\\n\",\"id\":\"pages/actions/transactions/putDeploy.mdx#notes\",\"isPage\":false,\"text\":\"\\n\\nFor new code, prefer putTransaction with NativeTransferBuilder or other builders.\\nDeploy is still supported by all Casper nodes including 2.x.\\n\\n\",\"title\":\"Notes\",\"titles\":[\"putDeploy\"]},{\"href\":\"/actions/transactions/putDeploy#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/putTransaction\\\"><code>putTransaction</code></a></li>\\n<li><a href=\\\"/actions/transactions/getDeploy\\\"><code>getDeploy</code></a></li>\\n</ul>\",\"id\":\"pages/actions/transactions/putDeploy.mdx#related\",\"isPage\":false,\"text\":\"\\n\\nputTransaction\\ngetDeploy\\n\",\"title\":\"Related\",\"titles\":[\"putDeploy\"]}]}}"
