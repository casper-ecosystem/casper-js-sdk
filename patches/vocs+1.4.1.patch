292E;--shiki-dark:#ADBAC7\\\">(tx);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Hash:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, result.transactionHash.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span></code></pre>\\n\",\"id\":\"pages/types/transaction.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst privateKey = PrivateKey.generate(KeyAlgorithm.ED25519);\\n \\nconst tx = new NativeTransferBuilder()\\n  .from(privateKey.publicKey)\\n  .target(PublicKey.fromHex(&#x27;01abc...&#x27;))\\n  .amount(&#x27;2500000000&#x27;)\\n  .id(Date.now())\\n  .chainName(&#x27;casper&#x27;)\\n  .payment(100_000_000)\\n  .build();\\n \\ntx.sign(privateKey);\\n \\nconst result = await client.putTransaction(tx);\\nconsole.log(&#x27;Hash:&#x27;, result.transactionHash.toHex());\\n\",\"title\":\"Usage\",\"titles\":[\"Transaction\"]},{\"href\":\"/types/transaction#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/types/deploy\\\"><code>Deploy</code></a> - Casper 1.x transaction format</li>\\n<li><a href=\\\"/types/transaction-v1-payload\\\"><code>TransactionV1Payload</code></a> - Payload structure</li>\\n<li><a href=\\\"/builders/introduction\\\">Transaction Builders</a> - High-level builders</li>\\n<li><a href=\\\"/actions/transactions/putTransaction\\\"><code>putTransaction</code></a> - Submit a transaction</li>\\n</ul>\",\"id\":\"pages/types/transaction.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nDeploy - Casper 1.x transaction format\\nTransactionV1Payload - Payload structure\\nTransaction Builders - High-level builders\\nputTransaction - Submit a transaction\\n\",\"title\":\"See Also\",\"titles\":[\"T