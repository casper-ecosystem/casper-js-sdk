BlockTransfersByHeight\"]},{\"href\":\"/actions/block/getBlockTransfersByHeight#height\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>number</code></li>\\n</ul>\\n<p>Block height.</p>\\n\",\"id\":\"pages/actions/block/getBlockTransfersByHeight.mdx#height\",\"isPage\":false,\"text\":\"\\n\\nType: number\\n\\nBlock height.\\n\",\"title\":\"height\",\"titles\":[\"getBlockTransfersByHeight\",\"Parameters\"]},{\"href\":\"/actions/block/getBlockTransfersByHeight#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n\",\"id\":\"pages/actions/block/getBlockTransfersByHeight.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\n\",\"title\":\"Return Value\",\"titles\":[\"getBlockTransfersByHeight\"]},{\"href\":\"/actions/block/getBlockTransfersByHeight#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/block/getLatestBlockTransfers\\\"><code>getLatestBlockTransfers</code></a></li>\\n<li><a href=\\\"/actions/block/getBlockTransfersByHash\\\"><code>getBlockTransfersByHash</code></a></li>\\n</ul>\",\"id\":\"pages/actions/block/getBlockTransfersByHeight.mdx#related\",\"isPage\":false,\"text\":\"\\n\\ngetLatestBlockTransfers\\ngetBlockTransfersByHash\\n\",\"title\":\"Related\",\"titles\":[\"getBlockTransfersByHeight\"]}]}}"
