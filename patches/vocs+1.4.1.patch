+## waitForTransaction
+
+Polls the node until a transaction is finalized, then returns the result.
+
+### Import
+
+```ts
+import { RpcClient, HttpHandler } from 'casper-js-sdk';
+```
+
+### Usage
+
+```ts
+const submitResult = await rpcClient.putTransaction(transaction);
+
+const tx = await rpcClient.waitForTransaction(
+  submitResult.transactionHash,
+  { timeout: 300_000 }
+);
+
+if (tx.executionInfo?.executionResult.isSuccess()) {
+  console.log('Confirmed!');
+} else {
+  const message = tx.executionInfo?.executionResult.getErrorMessage();
+  console.error('Failed:', message);
+}
+```
+
+### Parameters
+
+#### hash
+
+* **Type:** `string | Hash`
+
+The transaction hash to wait for.
+
+#### options (optional)
+
+* **Type:** `WaitOptions`
+
+```ts
+interface WaitOptions {
+  timeout?: number;   // Maximum wait time in ms. Default: 60000
+  interval?: number;  // Polling interval in ms. Default: 2000
+}
+```
+
+### Return Value
+
+`Promise<Transaction>`
+
+The finalized `Transaction` object with `executionInfo` populated.
+
+Throws if the timeout is reached before the transaction is finalized.
+
+### Example with Error Handling
+
+```ts
+try {
+  const tx = await rpcClient.waitForTransaction(hash, {
+    timeout: 300_000,  // 5 minutes
+    interval: 3_000,   // check every 3 seconds
+  });
+
+  const result = tx.executionInfo?.executionResult;
+  if (result?.isSuccess()) {
+    const transfers = result.getSuccessTransfers();
+    console.log('Transfers:', transfers?.length);
+  }
+} catch (err) {
+  console.error('Timed out waiting for transaction');
+}
+```
+
+### Related
+
+* [`putTransaction`](/actions/transactions/putTransaction)
+* [SSE: TransactionProcessed](/sse/transaction-processed) - event-based alternative
+
