pan style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  name: CLValue.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">newCLString</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;MyToken&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">),</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  symbol: CLValue.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">newCLString</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;MTK&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">),</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span></code></pre>\",\"id\":\"pages/clvalues/newCLString.mdx#example\",\"isPage\":false,\"text\":\"\\nconst args = Args.fromMap({\\n  name: CLValue.newCLString(&#x27;MyToken&#x27;),\\n  symbol: CLValue.newCLString(&#x27;MTK&#x27;),\\n});\",\"title\":\"Example\",\"titles\":[\"CLValue.newCLString\"]}]}}"
