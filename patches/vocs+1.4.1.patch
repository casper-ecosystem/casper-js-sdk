+"{\"value\":{\"mdx\":\"---\\nlayout: landing\\n---\\n\\nimport { HomePage } from 'vocs/components'\\n\\n<HomePage.Root>\\n  <img\\n    src=\\\"https://cdn.prod.website-files.com/668fef77d8ac075ed5e3f57a/66900f439d0597692b64fcf2_Casper_Wordmark_Red_RGB.png\\\"\\n    alt=\\\"Casper Network\\\"\\n    style={{ height: '48px', display: 'block', margin: '0 auto 24px' }}\\n  />\\n  <HomePage.Tagline>Casper JS SDK</HomePage.Tagline>\\n  <HomePage.Description>\\n    A complete TypeScript/JavaScript interface for the Casper Network.\\n    Build wallets, exchanges, dApps, and infrastructure with full type safety.\\n  </HomePage.Description>\\n  <HomePage.Buttons>\\n    <HomePage.Button href=\\\"/docs/getting-started\\\" variant=\\\"accent\\\">Get Started</HomePage.Button>\\n    <HomePage.Button href=\\\"/docs/introduction\\\">Why Casper JS SDK</HomePage.Button>\\n  </HomePage.Buttons>\\n  <HomePage.InstallPackage name=\\\"casper-js-sdk\\\" type=\\\"install\\\" />\\n</HomePage.Root>\\n\\n<div style={{ maxWidth: '900px', margin: '64px auto 0', padding: '0 24px' }}>\\n\\n## What is Casper?\\n\\n<div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))', gap: '16px', margin: '24px 0 48px' }}>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <strong>Proof-of-Stake Blockchain</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Casper is a permissionless, decentralized public blockchain secured by PoS consensus (Zug protocol). 100 validator slots, ~120-minute eras.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <strong>WebAssembly Smart Contracts</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Smart contracts compile to Wasm and execute in a deterministic sandbox. Supports Rust, AssemblyScript, and any language targeting Wasm.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <strong>CSPR Token</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Native token used for staking, delegation, and gas fees. 1 CSPR = 1,000,000,000 motes. Minimum transfer: 2.5 CSPR. Minimum delegation: 500 CSPR.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <strong>Casper 1.x & 2.0</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Casper 2.0 introduced TransactionV1, addressable entities, and new auction mechanics. The SDK supports both versions transparently.</p>\\n</div>\\n\\n</div>\\n\\n## Overview\\n\\n<div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(260px, 1fr))', gap: '16px', margin: '24px 0 48px' }}>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>🔐</div>\\n  <strong>Type-Safe Keys</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Full TypeScript types for ED25519 and SECP256K1 keys. Generate, import from PEM, sign, and verify - all with autocompletion.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>⚡</div>\\n  <strong>Fluent Transaction Builders</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Chainable builders for transfers, staking, contract calls, and WASM deploys. No manual serialization.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>🔌</div>\\n  <strong>Full RPC Coverage</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>80+ typed RPC methods: blocks, balances, transactions, auction state, global state queries, and more.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>📡</div>\\n  <strong>Real-Time Event Streaming</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>SSE client with typed handlers for block additions, transaction outcomes, finality signatures, and era steps.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>🔀</div>\\n  <strong>Casper 1.x & 2.x Support</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Full support for both legacy Deploy and modern TransactionV1. <code>CasperNetwork</code> auto-detects the node version.</p>\\n</div>\\n\\n<div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n  <div style={{ fontSize: '24px', marginBottom: '8px' }}>🌐</div>\\n  <strong>Browser & Node.js</strong>\\n  <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Dual bundles: CommonJS for Node.js and UMD for browsers. Zero configuration needed.</p>\\n</div>\\n\\n</div>\\n\\n## Quick Start\\n\\n```ts\\nimport {\\n  HttpHandler, RpcClient, NativeTransferBuilder,\\n  PrivateKey, KeyAlgorithm, PublicKey,\\n} from 'casper-js-sdk';\\n\\n// Connect to a node\\nconst rpcClient = new RpcClient(new HttpHandler('http://node:7777/rpc'));\\n\\n// Generate keys\\nconst privateKey = PrivateKey.generate(KeyAlgorithm.ED25519);\\n\\n// Build, sign, and submit a transfer\\nconst tx = new NativeTransferBuilder()\\n  .from(privateKey.publicKey)\\n  .target(PublicKey.fromHex('0202f5a92ab6da536e7b1a351406f3744224bec85d7acbab1497b65de48a1a707b64'))\\n  .amount('2500000000') // 2.5 CSPR in motes\\n  .id(Date.now())\\n  .chainName('casper')\\n  .payment(100_000_000)\\n  .build();\\n\\ntx.sign(privateKey);\\n\\nconst result = await rpcClient.putTransaction(tx);\\nconsole.log('Hash:', result.transactionHash);\\n```\\n\\n## Community & Support\\n\\n<div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '16px', margin: '24px 0 48px' }}>\\n\\n<a href=\\\"https://github.com/casper-ecosystem/casper-js-sdk\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px', transition: 'border-color 0.2s' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>⭐</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>GitHub</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Source code, issues, and pull requests. Star the repo to follow updates.</p>\\n  </div>\\n</a>\\n\\n<a href=\\\"https://github.com/casper-ecosystem/casper-js-sdk/issues\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>🐛</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>Bug Reports</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Found an issue? Open a GitHub issue with a minimal reproduction.</p>\\n  </div>\\n</a>\\n\\n<a href=\\\"https://github.com/casper-ecosystem/casper-js-sdk/releases\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>📦</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>Changelog</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Release notes and version history for every SDK release.</p>\\n  </div>\\n</a>\\n\\n<a href=\\\"https://discord.gg/casperblockchain\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>💬</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>Discord</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Chat with the Casper developer community and get help from the team.</p>\\n  </div>\\n</a>\\n\\n<a href=\\\"https://docs.casper.network\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>📖</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>Protocol Docs</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Official Casper Network documentation covering the protocol and node operation.</p>\\n  </div>\\n</a>\\n\\n<a href=\\\"https://www.npmjs.com/package/casper-js-sdk\\\" style={{ textDecoration: 'none' }}>\\n  <div style={{ border: '1px solid var(--vocs-color_border)', borderRadius: '12px', padding: '20px 24px' }}>\\n    <div style={{ fontSize: '24px', marginBottom: '8px' }}>📬</div>\\n    <strong style={{ color: 'var(--vocs-color_text)' }}>npm Package</strong>\\n    <p style={{ color: 'var(--vocs-color_text3)', margin: '8px 0 0', fontSize: '14px' }}>Package info, version history, and download stats on npm.</p>\\n  </div>\\n</a>\\n\\n</div>\\n\\n</div>\\n\",\"document\":[{\"href\":\"#what-is-casper\",\"html\":\"<div style=\\\"display:grid;grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:16px;margin:24px 0 48px\\\"><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><strong>Proof-of-Stake Blockchain</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Casper is a permissionless, decentralized public blockchain secured by PoS consensus (Zug protocol). 100 validator slots, ~120-minute eras.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><strong>WebAssembly Smart Contracts</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Smart contracts compile to Wasm and execute in a deterministic sandbox. Supports Rust, AssemblyScript, and any language targeting Wasm.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><strong>CSPR Token</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Native token used for staking, delegation, and gas fees. 1 CSPR = 1,000,000,000 motes. Minimum transfer: 2.5 CSPR. Minimum delegation: 500 CSPR.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><strong>Casper 1.x &amp; 2.0</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Casper 2.0 introduced TransactionV1, addressable entities, and new auction mechanics. The SDK supports both versions transparently.</p></div></div>\",\"id\":\"pages/#what-is-casper\",\"isPage\":true,\"text\":\"Proof-of-Stake BlockchainCasper is a permissionless, decentralized public blockchain secured by PoS consensus (Zug protocol). 100 validator slots, ~120-minute eras.WebAssembly Smart ContractsSmart contracts compile to Wasm and execute in a deterministic sandbox. Supports Rust, AssemblyScript, and any language targeting Wasm.CSPR TokenNative token used for staking, delegation, and gas fees. 1 CSPR = 1,000,000,000 motes. Minimum transfer: 2.5 CSPR. Minimum delegation: 500 CSPR.Casper 1.x &amp; 2.0Casper 2.0 introduced TransactionV1, addressable entities, and new auction mechanics. The SDK supports both versions transparently.\",\"title\":\"What is Casper?\",\"titles\":[null]},{\"href\":\"#overview\",\"html\":\"<div style=\\\"display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:16px;margin:24px 0 48px\\\"><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">🔐</div><strong>Type-Safe Keys</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Full TypeScript types for ED25519 and SECP256K1 keys. Generate, import from PEM, sign, and verify - all with autocompletion.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">⚡</div><strong>Fluent Transaction Builders</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Chainable builders for transfers, staking, contract calls, and WASM deploys. No manual serialization.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">🔌</div><strong>Full RPC Coverage</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">80+ typed RPC methods: blocks, balances, transactions, auction state, global state queries, and more.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">📡</div><strong>Real-Time Event Streaming</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">SSE client with typed handlers for block additions, transaction outcomes, finality signatures, and era steps.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">🔀</div><strong>Casper 1.x &amp; 2.x Support</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Full support for both legacy Deploy and modern TransactionV1. <code>CasperNetwork</code> auto-detects the node version.</p></div><div style=\\\"border:1px solid var(--vocs-color_border);border-radius:12px;padding:20px 24px\\\"><div style=\\\"font-size:24px;margin-bottom:8px\\\">🌐</div><strong>Browser &amp; Node.js</strong><p style=\\\"color:var(--vocs-color_text3);margin:8px 0 0;font-size:14px\\\">Dual bundles: CommonJS for Node.js and UMD for browsers. Zero configuration needed.</p></div></div>\",\"id\":\"pages/#overview\",\"isPage\":false,\"text\":\"🔐Type-Safe KeysFull TypeScript types for ED25519 and SECP256K1 keys. Generate, import from PEM, sign, and verify - all with autocompletion.⚡Fluent Transaction BuildersChainable builders for transfers, staking, contract calls, and WASM deploys. No manual serialization.🔌Full RPC Coverage80+ typed RPC methods: blocks, balances, transactions, auction state, global state queries, and more.📡Real-Time Event StreamingSSE client with typed handlers for block additions, transaction outcomes, finality signatures, and era steps.🔀Casper 1.x &amp; 2.x SupportFull support for both legacy Deploy and modern TransactionV1. CasperNetwork auto-detects the node version.🌐Browser &amp; Node.jsDual bundles: CommonJS for Node.js and UMD for browsers. Zero configuration needed.\",\"title\":\"Overview\",\"titles\":[null]},{\"href\":\"#quick-start\",\"html\":\"<pre class=\\\"shiki shiki-themes github-light github-dark-dimmed\\\" style=\\\"background-color:#fff;--shiki-dark-bg:#22272e;color:#24292e;--shiki-dark:#adbac7\\\" tabindex=\\\"0\\\"><code><span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  HttpHandler, RpcClient, NativeTransferBuilder,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  PrivateKey, KeyAlgorithm, PublicKey,</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">} from </span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;casper-js-sdk&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">;</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Connect to a node</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> rpcClient</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> RpcClient</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> HttpHandler</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;http://node:7777/rpc&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">));</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Generate keys</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> privateKey</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> PrivateKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">generate</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(KeyAlgorithm.</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">ED25519</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Build, sign, and submit a transfer</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> tx</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> NativeTransferBuilder</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">()</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">from</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(privateKey.publicKey)</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">target</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(PublicKey.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">fromHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;0202f5a92ab6da536e7b1a351406f3744224bec85d7acbab1497b65de48a1a707b64&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">))</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">amount</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;2500000000&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">) </span><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// 2.5 CSPR in motes</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">id</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(Date.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">now</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">())</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">chainName</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;casper&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">)</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">payment</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">100_000_000</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">)</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  .</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">build</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">tx.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">sign</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(privateKey);</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> result</span><span style=\\\"c