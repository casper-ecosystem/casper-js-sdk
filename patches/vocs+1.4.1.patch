><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> args2</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> Args</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> Map</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">args2.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">insert</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;token_id&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, </span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">newCLU256</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;42&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">));</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Retrieve a value</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> amount</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> args.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">getByName</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;amount&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span></code></pre>\\n\",\"id\":\"pages/types/args.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\n// Build args from a plain object\\nconst args = Args.fromMap({\\n  recipient: newCLString(&#x27;account-hash-abc...&#x27;),\\n  amount: newCLU256(&#x27;1000000000&#x27;),\\n});\\n \\n// Or insert incrementally\\nconst args2 = new Args(new Map());\\nargs2.insert(&#x27;token_id&#x27;, newCLU256(&#x27;42&#x27;));\\n \\n// Retrieve a value\\nconst amount = args.getByName(&#x27;amount&#x27;);\\n\",\"title\":\"Usage\",\"titles\":[\"Args\"]},{\"href\":\"/types/args#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/clvalues/introduction\\\">CLValues Introduction</a> - Available CL value types</li>\\n<li><a href=\\\"/clvalues/Args\\\">Args reference</a> - Detailed Args documentation</li>\\n<li><a href=\\\"/builders/ContractCallBuilder\\\"><code>ContractCallBuilder</code></a> - Uses <code>Args</code> for contract calls</li>\\n</ul>\",\"id\":\"pages/types/args.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nCLValues Introduction - Available CL value types\\nArgs reference - Detailed Args documentation\\nContractCallBuilder - Uses Args for contract calls\\n\",\"title\":\"See Also\",\"titles\":[\"Args\"]}]}}"
