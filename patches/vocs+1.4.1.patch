an></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Deploy hash:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, v1.deployHash.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  }</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/types/transfer.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\nconst client = new RpcClient(new HttpHandler(&#x27;http://node:7777/rpc&#x27;));\\n \\n// Get block transfers\\nconst { transfers } = await client.getLatestBlockTransfers();\\n \\nfor (const t of transfers) {\\n  console.log(&#x27;Amount:&#x27;, t.amount.toString());\\n  console.log(&#x27;Source:&#x27;, t.source.toJSON());\\n  console.log(&#x27;Target:&#x27;, t.target.toJSON());\\n \\n  const v1 = t.getTransferV1();\\n  if (v1) {\\n    console.log(&#x27;Deploy hash:&#x27;, v1.deployHash.toHex());\\n  }\\n}\\n\",\"title\":\"Usage\",\"titles\":[\"Transfer\"]},{\"href\":\"/types/transfer#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/block/getLatestBlockTransfers\\\"><code>getLatestBlockTransfers</code></a> - Returns <code>Transfer[]</code></li>\\n<li><a href=\\\"/types/execution-result\\\"><code>ExecutionResult</code></a> - Contains transfers</li>\\n<li><a href=\\\"/types/stored-value\\\"><code>StoredValue</code></a> - Contains optional <code>transfer</code></li>\\n</ul>\",\"id\":\"pages/types/transfer.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\ngetLatestBlockTransfers - Returns Transfer[]\\nExecutionResult - Contains transfers