an><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> toBytesU32</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">42</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Uint8Array [42, 0, 0, 0]</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Serialize a string</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> strBytes</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> toBytesString</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;hello&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// [5, 0, 0, 0, 104, 101, 108, 108, 111]</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> str</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> fromBytesString</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(strBytes);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// &#x27;hello&#x27;</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Compute a Blake2b hash</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> hash</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> byteHash</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">new</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\"> Uint8Array</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">([</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">1</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">2</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, </span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\">3</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">]));</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">// Uint8Array(32) [...]</span></span></code></pre>\\n\",\"id\":\"pages/types/byte-converters.mdx#usage\",\"isPage\":false,\"text\":\"\\n \\n \\n// Serialize a u32\\nconst bytes = toBytesU32(42);\\n// Uint8Array [42, 0, 0, 0]\\n \\n// Serialize a string\\nconst strBytes = toBytesString(&#x27;hello&#x27;);\\n// [5, 0, 0, 0, 104, 101, 108, 108, 111]\\n \\nconst str = fromBytesString(strBytes);\\n// &#x27;hello&#x27;\\n \\n// Compute a Blake2b hash\\nconst hash = byteHash(new Uint8Array([1, 2, 3]));\\n// Uint8Array(32) [...]\\n\",\"title\":\"Usage\",\"titles\":[\"ByteConverters\"]},{\"href\":\"/types/byte-converters#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/types/conversions\\\"><code>Conversions</code></a> - Base64/hex encoding and CSPR↔motes conversion</li>\\n<li><a href=\\\"/types/hex-bytes\\\"><code>HexBytes</code></a> - Hex string wrapper</li>\\n</ul>\",\"id\":\"pages/types/byte-converters.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nConversions - Base64/hex encoding and CSPR↔motes conversion\\nHexBytes - Hex string wrapper\\n\",\"title\":\"See Also\",\"titles\":[\"ByteConverters\"]}]}}"
