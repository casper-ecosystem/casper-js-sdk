.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Era ID:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, step.eraId);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#6A737D;--shiki-dark:#768390\\\">  // step.executionEffect contains all state changes from the era step</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span></code></pre>\\n\",\"id\":\"pages/sse/step.mdx#usage\",\"isPage\":false,\"text\":\"\\nsseClient.subscribe(EventName.StepEventType, (raw) =&gt; {\\n  const result = raw.parseAsStepEvent();\\n  if (result.err) return;\\n \\n  const step = result.val.step;\\n  console.log(&#x27;Era ID:&#x27;, step.eraId);\\n  // step.executionEffect contains all state changes from the era step\\n});\\n\",\"title\":\"Usage\",\"titles\":[\"Step\"]},{\"href\":\"/sse/step#payload\",\"html\":\"\\n\",\"id\":\"pages/sse/step.mdx#payload\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Payload\",\"titles\":[\"Step\"]},{\"href\":\"/sse/step#steppayload\",\"html\":\"\\n<table><thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead><tbody><tr><td><code>eraId</code></td><td><code>number</code></td><td>The era that just completed</td></tr><tr><td><code>executionEffect</code></td><td><code>ExecutionEffect</code></td><td>State changes from reward distribution</td></tr></tbody></table>\\n\",\"id\":\"pages/sse/step.mdx#steppayload\",\"isPage\":false,\"text\":\"\\nFieldTypeDescriptioneraIdnumberThe era that just completedexecutionEffectExecutionEffectState changes from reward distribution\\n\",\"title\":\"StepPayload\",\"titles\":[\"Step\",\"Payload\"]},{\"href\":\"/sse/step#notes\",\"html\":\"\\n<ul>\\n<li>Eras on mainnet are approximately 2 hours long.</li>\\n<li>The step event includes validator activations/deactivations and reward distributions.</li>\\n<li>Subscribe to this event to track staking reward payouts.</li>\\n</ul>\\n\",\"id\":\"pages/sse/step.mdx#notes\",\"isPage\":false,\"text\":\"\\n\\nEras on mainnet are approximately 2 hours long.\\nThe step event includes validator activations/deactivations and reward distributions.\\nSubscribe to this event to track staking reward payouts.\\n\\n\",\"title\":\"Notes\",\"titles\":[\"Step\"]},{\"href\":\"/sse/step#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/auction/getLatestAuctionInfo\\\"><code>getLatestAuctionInfo</code></a></li>\\n<li><a href=\\\"/actions/auction/getLatestValidatorReward\\\"><code>getLatestValidatorReward</code></a></li>\\n</ul>\",\"id\":\"pages/sse/step.mdx#related\",\"isPage\":false,\"text\":\"\\n\\ngetLatestAuctionInfo\\ngetLatestValidatorReward\\n\",\"title\":\"Related\",\"titles\":[\"Step\"]}]}}"
