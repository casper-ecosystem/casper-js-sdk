#ADBAC7\\\">, blockInfo.hash.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">&#x27;Creator:&#x27;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">, blockInfo.creator.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toHex</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">());</span></span></code></pre>\\n\",\"id\":\"pages/types/minimal-block-info.mdx#usage\",\"isPage\":false,\"text\":\"\\n// MinimalBlockInfo typically appears in RPC responses like getEraSummary\\nconst { eraSummary } = await client.getEraSummaryLatest();\\n \\n// Block info is also embedded in various RPC responses\\nconst blockInfo: MinimalBlockInfo = /* from RPC response */;\\nconsole.log(&#x27;Height:&#x27;, blockInfo.height);\\nconsole.log(&#x27;Hash:&#x27;, blockInfo.hash.toHex());\\nconsole.log(&#x27;Creator:&#x27;, blockInfo.creator.toHex());\\n\",\"title\":\"Usage\",\"titles\":[\"MinimalBlockInfo\"]},{\"href\":\"/types/minimal-block-info#see-also\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/types/block\\\"><code>Block</code></a> - Full block with transactions and proofs</li>\\n<li><a href=\\\"/types/era-summary\\\"><code>EraSummary</code></a> - Contains minimal block context</li>\\n</ul>\",\"id\":\"pages/types/minimal-block-info.mdx#see-also\",\"isPage\":false,\"text\":\"\\n\\nBlock - Full block with transactions and proofs\\nEraSummary - Contains minimal block context\\n\",\"title\":\"See Also\",\"titles\":[\"MinimalBlockInfo\"]}]}}"
