ckHeight.mdx#parameters\",\"isPage\":false,\"text\":\"\\n\",\"title\":\"Parameters\",\"titles\":[\"queryBalanceByBlockHeight\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHeight#height\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>number</code></li>\\n</ul>\\n<p>Block height.</p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHeight.mdx#height\",\"isPage\":false,\"text\":\"\\n\\nType: number\\n\\nBlock height.\\n\",\"title\":\"height\",\"titles\":[\"queryBalanceByBlockHeight\",\"Parameters\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHeight#identifier\",\"html\":\"\\n<ul>\\n<li><strong>Type:</strong> <code>PurseIdentifier</code></li>\\n</ul>\\n<p>Which purse to query.</p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHeight.mdx#identifier\",\"isPage\":false,\"text\":\"\\n\\nType: PurseIdentifier\\n\\nWhich purse to query.\\n\",\"title\":\"identifier\",\"titles\":[\"queryBalanceByBlockHeight\",\"Parameters\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHeight#return-value\",\"html\":\"\\n<p><code>Promise</code></p>\\n\",\"id\":\"pages/actions/balance/queryBalanceByBlockHeight.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\n\",\"title\":\"Return Value\",\"titles\":[\"queryBalanceByBlockHeight\"]},{\"href\":\"/actions/balance/queryBalanceByBlockHeight#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/balance/queryLatestBalance\\\"><code>queryLatestBalance</code></a></li>\\n<li><a href=\\\"/actions/balance/queryBalanceByBlockHash\\\"><code>queryBalanceByBlockHash</code></a></li>\\n</ul>\",\"id\":\"pages/actions/balance/queryBalanceByBlockHeight.mdx#related\",\"isPage\":false,\"text\":\"\\n\\nqueryLatestBalance\\nqueryBalanceByBlockHash\\n\",\"title\":\"Related\",\"titles\":[\"queryBalanceByBlockHeight\"]}]}}"
