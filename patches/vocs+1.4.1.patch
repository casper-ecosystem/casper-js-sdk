\\">;</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#E36209;--shiki-dark:#F69D50\\\">  executionResults</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">:</span><span style=\\\"color:#6F42C1;--shiki-dark:#F69D50\\\"> DeployExecutionResult</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">[];</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">}</span></span></code></pre>\\n\",\"id\":\"pages/actions/transactions/getDeploy.mdx#return-value\",\"isPage\":false,\"text\":\"\\nPromise\\ninterface InfoGetDeployResult {\\n  deploy: Deploy;\\n  executionResults: DeployExecutionResult[];\\n}\\n\",\"title\":\"Return Value\",\"titles\":[\"getDeploy\"]},{\"href\":\"/actions/transactions/getDeploy#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/getTransactionByDeployHash\\\"><code>getTransactionByDeployHash</code></a></li>\\n<li><a href=\\\"/actions/transactions/putDeploy\\\"><code>putDeploy</code></a></li>\\n</ul>\",\"id\":\"pages/actions/transactions/getDeploy.mdx#related\",\"isPage\":false,\"text\":\"\\n\\ngetTransactionByDeployHash\\nputDeploy\\n\",\"title\":\"Related\",\"titles\":[\"getDeploy\"]}]}}"
