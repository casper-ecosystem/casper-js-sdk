#DCBDFB\\\">getTransferV1</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">    if</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">!</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">transfer) </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">continue</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">;</span></span>\\n<span class=\\\"line\\\" data-empty-line=\\\"true\\\"> </span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">    const</span><span style=\\\"color:#005CC5;--shiki-dark:#6CB6FF\\\"> to</span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\"> =</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> transfer.to?.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">toFormattedStr</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">();</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">    if</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> (to </span><span style=\\\"color:#D73A49;--shiki-dark:#F47067\\\">&amp;&amp;</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\"> myAddresses.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">has</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(to)) {</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">      console.</span><span style=\\\"color:#6F42C1;--shiki-dark:#DCBDFB\\\">log</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">(</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">`Deposit: ${</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">transfer</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">.</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">amount</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">} motes to ${</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">to</span><span style=\\\"color:#032F62;--shiki-dark:#96D0FF\\\">}`</span><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">);</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">    }</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">  }</span></span>\\n<span class=\\\"line\\\"><span style=\\\"color:#24292E;--shiki-dark:#ADBAC7\\\">});</span></span></code></pre>\\n\",\"id\":\"pages/sse/transaction-processed.mdx#exchange-deposit-detection-example\",\"isPage\":false,\"text\":\"\\nconst myAddresses = new Set([\\n  &#x27;account-hash-abc...&#x27;,\\n  &#x27;account-hash-def...&#x27;,\\n]);\\n \\nsseClient.subscribe(EventName.TransactionProcessedEventType, (raw) =&gt; {\\n  const result = raw.parseAsTransactionProcessedEvent();\\n  if (result.err) return;\\n \\n  const { executionResult } = result.val.transactionProcessed;\\n  if (!executionResult.isSuccess()) return;\\n \\n  const transfers = executionResult.getSuccessTransfers() ?? [];\\n  for (const t of transfers) {\\n    const transfer = t.getTransferV2() ?? t.getTransferV1();\\n    if (!transfer) continue;\\n \\n    const to = transfer.to?.toFormattedStr();\\n    if (to &amp;&amp; myAddresses.has(to)) {\\n      console.log(`Deposit: ${transfer.amount} motes to ${to}`);\\n    }\\n  }\\n});\\n\",\"title\":\"Exchange Deposit Detection Example\",\"titles\":[\"TransactionProcessed\"]},{\"href\":\"/sse/transaction-processed#related\",\"html\":\"\\n<ul>\\n<li><a href=\\\"/actions/transactions/waitForTransaction\\\"><code>waitForTransaction</code></a> - polling alternative</li>\\n<li><a href=\\\"/sse/transaction-accepted\\\"><code>TransactionAccepted</code></a></li>\\n</ul>\",\"id\":\"pages/sse/transaction-processed.mdx#related\",\"isPage\":false,\"text\":\"\\n\\nwaitForTransaction - polling alternative\\nTransactionAccepted\\n\",\"title\":\"Related\",\"titles\":[\"TransactionProcessed\"]}]}}"
