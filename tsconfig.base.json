{
  "compilerOptions": {
    // TS 6 flipped three defaults. `types` and the `target`/`moduleResolution`
    // deprecations below are pinned back to what 4.9 did; `strict` itself is
    // deliberately on, with one flag of the family pinned off next.
    "strict": true,
    // typedjson populates `@jsonObject` fields after construction, so none of
    // those classes initialize them: 389 TS2564 errors. Everything else in the
    // strict family stays on.
    "strictPropertyInitialization": false,
    // `types` now defaults to [], dropping the ambient Node globals the build
    // needs for `Buffer`. This fixes the internal build only — the shipped
    // .d.ts still requires @types/node, which must stay out of `dependencies`.
    "types": ["node"],
    // `target: es5` and `moduleResolution: node10` are deprecated in 6.0 but
    // stay for the whole 5.x line.
    "ignoreDeprecations": "6.0",
    "outDir": "./dist/",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "target": "es5",
    // es2022 for `Error.cause` (used by preserve-caught-error). This changes
    // type-checking only — `target` stays es5, so emit is unaffected. On a
    // pre-ES2022 runtime the options argument is ignored and `cause` is simply
    // absent; that is additive and acceptable.
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  }
}
