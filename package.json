{
  "name": "casper-js-sdk",
  "version": "5.2.0",
  "license": "Apache 2.0",
  "description": "SDK to interact with the Casper blockchain",
  "homepage": "https://github.com/casper-ecosystem/casper-js-sdk#README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/casper-ecosystem/casper-js-sdk.git"
  },
  "main": "dist/lib.node.js",
  "browser": "dist/lib.web.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/lib.web.js",
      "browser": "./dist/lib.web.js",
      "require": "./dist/lib.node.js",
      "default": "./dist/lib.node.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src/ --fix",
    "lint:ci": "eslint src/ --max-warnings=0",
    "knip": "knip --include dependencies,unlisted,binaries,unresolved",
    "knip:all": "knip",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "check:package": "publint && attw --pack . --ignore-rules named-exports && tsc -p tsconfig.dts-consumer.json",
    "setup": "npm install && allow-scripts && npm run prepare",
    "build": "npm run clean && npm run lint && webpack --config webpack.config.js",
    "clean": "rm -rf ./dist",
    "~build": "tsc --watch",
    "test:node:unit": "vitest run",
    "test:node:unit:coverage": "vitest run --coverage",
    "test:browser:unit": "vitest run --browser",
    "test:unit": "npm run test:node:unit && npm run test:browser:unit",
    "test:node:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e": "npm run test:node:e2e",
    "test": "npm run test:unit && npm run test:e2e",
    "docs:build": "cd site && npm ci && npm run build && cd .. && typedoc --out docs/api",
    "docs:dev": "cd site && npm install && npm run dev",
    "docs:preview": "cd site && npm run preview",
    "prepublishOnly": "npm run build && npm run test:node:unit && npm run check:package"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "Casper",
    "BlockChain",
    "sdk"
  ],
  "author": "Jan Hoffmann <jan@casperlabs.io>",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^22.20.1",
    "@types/sinon": "^21.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^16.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.4",
    "process": "^0.11.10",
    "publint": "^0.3.23",
    "sinon": "^22.0.0",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10",
    "webpack": "^5.108.3",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.1.0",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "minimatch": "^10.2.3",
    "brace-expansion": "^5.0.9",
    "follow-redirects": "^1.16.0",
    "serialize-javascript": "^7.0.7",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  },
  "dependencies": {
    "@ethersproject/bignumber": "^5.8.0",
    "@ethersproject/bytes": "^5.8.0",
    "@ethersproject/constants": "^5.8.0",
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^1.7.5",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.2",
    "@peculiar/asn1-ecc": "^2.8.0",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "axios": "^1.19.0",
    "eventsource": "^3.0.7",
    "humanize-duration": "^3.34.0",
    "ts-results": "npm:@casperlabs/ts-results@^3.3.5",
    "typedjson": "^1.8.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail#3.0.0": false
    }
  }
}
